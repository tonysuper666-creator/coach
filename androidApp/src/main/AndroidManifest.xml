<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Coach" android:theme="@style/Theme.Coach" android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="false">
        <!-- 今天 / 学习：日常使用的入口 -->
        <activity android:name=".CoachActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LabActivity" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|uiMode" />
        <!-- M0 渲染 spike：仍可 `am start -n com.coach.android/.MainActivity` 直接打开 -->
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|uiMode" />
    </application>
</manifest>
