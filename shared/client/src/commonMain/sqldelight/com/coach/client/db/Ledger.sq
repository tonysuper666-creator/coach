CREATE TABLE replica(seq INTEGER PRIMARY KEY,course_id TEXT NOT NULL,event_json TEXT NOT NULL);
CREATE TABLE outbox(command_id TEXT PRIMARY KEY,device_id TEXT NOT NULL,payload_bytes TEXT NOT NULL,payload_sha256 TEXT NOT NULL,ack_seq INTEGER,receipt_status TEXT);
CREATE TABLE sync_meta(key TEXT PRIMARY KEY,value TEXT NOT NULL);

allEvents:
SELECT event_json FROM replica WHERE course_id=? ORDER BY seq;
putEvent:
INSERT OR IGNORE INTO replica VALUES(?,?,?);
clearReplica:
DELETE FROM replica;
allCommands:
SELECT * FROM outbox ORDER BY rowid;
putCommand:
INSERT INTO outbox(command_id,device_id,payload_bytes,payload_sha256) VALUES(?,?,?,?);
ackCommand:
UPDATE outbox SET ack_seq=?,receipt_status=? WHERE command_id=?;
replayAfter:
UPDATE outbox SET ack_seq=NULL,receipt_status=NULL WHERE ack_seq>? AND receipt_status<>'REJECTED';
prune:
DELETE FROM outbox WHERE ack_seq IS NOT NULL AND ack_seq<=? AND receipt_status<>'REJECTED';
getMeta:
SELECT value FROM sync_meta WHERE key=?;
putMeta:
INSERT INTO sync_meta VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value;

CREATE TABLE projection_cache(course_id TEXT PRIMARY KEY,version INTEGER NOT NULL,last_seq INTEGER NOT NULL,epoch TEXT NOT NULL,projection_json TEXT NOT NULL);
CREATE INDEX replica_course_seq ON replica(course_id,seq);

replicaSeq:
SELECT coalesce(max(seq),0) FROM replica WHERE course_id=?;
getProjection:
SELECT projection_json FROM projection_cache WHERE course_id=? AND version=? AND last_seq=? AND epoch=?;
putProjection:
INSERT INTO projection_cache VALUES(?,?,?,?,?) ON CONFLICT(course_id) DO UPDATE SET version=excluded.version,last_seq=excluded.last_seq,epoch=excluded.epoch,projection_json=excluded.projection_json;
clearProjections:
DELETE FROM projection_cache;
