    {
      "name": "inline-math-text-chinese-allowed",
      "source": "library",
      "input": "$Q_{\\text{自付}} = q(1-s)$",
      "expect": [
        {
          "math": "Q_{\\text{自付}} = q(1-s)",
          "display": false
        }
      ],
      "note": "\\text{} 里的中文是合法公式"
    }
  ]
}
