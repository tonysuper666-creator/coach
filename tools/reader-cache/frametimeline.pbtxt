buffers { size_kb: 32768 fill_policy: RING_BUFFER }
duration_ms: 30000
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_apps: "com.coach.readermeasurement"
    }
  }
}
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
